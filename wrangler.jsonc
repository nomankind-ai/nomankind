{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomankind",
  // Written by another builder in M10; its absence does not affect the
  // bindings-only proxy the storage tests open through getPlatformProxy.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-07",
  // No nodejs_compat: the kernel runs on WebCrypto only, and nothing under
  // src/ imports a node: module. Keeping the flag off makes that a build error
  // rather than a surprise in production.
  "observability": {
    "enabled": true
  },
  // No workers.dev route exists for either environment: both are reached only
  // through their custom domains, so there is no second public hostname
  // serving the same Worker.
  "workers_dev": false,
  "preview_urls": false,
  // The sweep (src/worker/sweep.ts): commit the pool snapshot when it has
  // moved, close the assignments whose seventy-two hours have run out, and draw
  // for the entries owed a draw. Every five minutes.
  //
  // This cadence is deployment configuration and NOT a policy number: it says
  // how often the Worker looks, never how long a validator has (that is
  // ASSIGNMENT_WINDOW_HOURS in src/policy.ts) or when a draw is legitimate
  // (src/assign.ts). Moving it changes only how promptly the log catches up.
  //
  // `triggers` is an inheritable key, so demo and production run the same
  // schedule from this one block; `wrangler deploy --dry-run --env demo` and
  // `--env production` both report the trigger.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // The sweep's own timer (src/worker/sweeper.ts), and the reason it exists:
  // the cron trigger above was registered on the demo Worker and watched for an
  // hour across six deploys and a re-add by hand without firing once — no
  // scheduled invocation and no error. A Durable Object alarm is a real timer
  // on the free plan and it is ours: the object arms it, the platform delivers
  // it, and the object arms the next one before it returns. Any request to the
  // Worker arms it if it is not armed.
  //
  // The cron stays as a second, harmless timer: the sweep is idempotent, so two
  // of them are two chances to catch up rather than a race.
  //
  // The cadence is SWEEP_INTERVAL_MINUTES in src/policy.ts, which the class
  // reads; it is operational and not a rule of the paper.
  //
  // `migrations` is inheritable, so the one block below covers every
  // environment; `durable_objects` is NOT (the config schema says so in as many
  // words), so the binding is repeated in env.demo and env.production.
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed, which is the storage class the free plan allows.
      "new_sqlite_classes": ["Sweeper"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SWEEPER",
        "class_name": "Sweeper"
      }
    ]
  },
  // The local (default) environment: the database miniflare creates for tests
  // and `wrangler dev`. Nothing here reaches Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nomankind-local",
      // PLACEHOLDER: local D1 never reads this id. M11 leaves it as is.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The snapshot archive (norm-v1.2 step 2): the raw capture at the hash of its
  // body bytes, and its sidecar beside it at "<hash>.meta.json". Content
  // addressed and write-once, so a bucket is an archive and never a cache.
  // The local bucket is miniflare's own and never reaches Cloudflare.
  "r2_buckets": [
    {
      "binding": "CAPTURES",
      "bucket_name": "nomankind-local-captures"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    // The maintainer's agent id (D-016). A throwaway key generated by this
    // repository's own keygen: local is a development database and nothing
    // signed with it is worth anything anywhere else.
    "MAINTAINER_AGENT_ID": "1F916:t2clwNKCX9MD246hQJgDKVoqhC7Q-ybl4x7xvRGWt40"
  },
  "env": {
    "demo": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nomankind-demo",
          // The demo database exists; created 2026-09-07 under D-015.
          "database_id": "1e2ef41a-a126-48f5-a24d-96831c339d80",
          "migrations_dir": "migrations"
        }
      ],
      // Repeated because durable_objects is not inherited from the top level.
      "durable_objects": {
        "bindings": [
          {
            "name": "SWEEPER",
            "class_name": "Sweeper"
          }
        ]
      },
      // The demo archive; the bucket exists, created 2026-09-08 in region ENAM.
      "r2_buckets": [
        {
          "binding": "CAPTURES",
          "bucket_name": "nomankind-demo-captures"
        }
      ],
      // A custom domain: Cloudflare creates the DNS record and issues the
      // certificate on deploy, so nothing has to be wired by hand.
      "routes": [
        {
          "pattern": "demo.nomankind.ai",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      // Pull-request versions are uploaded, not deployed, and are reached
      // through their workers.dev preview URLs.
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "demo",
        // A second throwaway key from the same keygen (D-016), distinct from
        // local's: demo is a public environment, and a key it shares with a
        // laptop is a key anyone can claim to be.
        "MAINTAINER_AGENT_ID": "1F916:C-5gOmupEFPPWU-QfHTwvFNG6tdY4mqFdkKCyFPdtjs"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nomankind-production",
          // The production database exists; created 2026-09-07 under D-015.
          "database_id": "19510637-03c0-4fc9-8c94-149d8f95ef05",
          "migrations_dir": "migrations"
        }
      ],
      // Repeated because durable_objects is not inherited from the top level.
      "durable_objects": {
        "bindings": [
          {
            "name": "SWEEPER",
            "class_name": "Sweeper"
          }
        ]
      },
      // The production archive; the bucket exists, created 2026-09-08 in ENAM.
      "r2_buckets": [
        {
          "binding": "CAPTURES",
          "bucket_name": "nomankind-production-captures"
        }
      ],
      // Every custom domain: Cloudflare creates the DNS records and issues the
      // certificates on deploy. The apex serves the landing page; the www host
      // is routed here only so the Worker can redirect it to the apex
      // (src/worker/pages.ts), which is why nothing is served on it.
      "routes": [
        {
          "pattern": "app.nomankind.ai",
          "custom_domain": true
        },
        {
          "pattern": "nomankind.ai",
          "custom_domain": true
        },
        {
          "pattern": "www.nomankind.ai",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        // Empty on purpose (D-016): the maintainer sets this from their own
        // key in M25, and no throwaway key generated in a repository is ever
        // going to hold the genesis naming power in public. Empty means no
        // maintainer is configured, so production refuses genesis naming
        // outright rather than granting it to whoever asks first.
        "MAINTAINER_AGENT_ID": "",
        // The sealing agent's handle at the founding 1F916 registry (D-054).
        // The citizen is registered under this handle since 2026-09-09, so the
        // registry track is available; an empty handle would mean no registry
        // track and a sweep that seals locally instead.
        //
        // A handle is public, so it is a var. The two secrets that go with it —
        // SEALING_AGENT_KEY and REGISTRY_CREDENTIAL — are set with
        // `wrangler secret put` and are never in this file.
        "SEALING_AGENT_HANDLE": "nomankind",
        // The apex hostname, whose `/` serves the landing page rather than the
        // app's home (D-021). Production is the only environment that routes
        // two hostnames, so it is the only one that sets this; local and demo
        // have one hostname each and serve the app at `/`.
        "APEX_HOST": "nomankind.ai"
      }
    }
  }
}
